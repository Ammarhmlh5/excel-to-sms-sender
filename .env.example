SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_xxx
HUDHUD_API_KEY=your_hudhud_api_key
HUDHUD_SENDER_ID=optional_sender_id
HUDHUD_BASE_URL=https://api.hloov.com/api/sms/send

# Copy this file to .env and fill values to run local scripts like `npm run set:hudhud`
# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Edge Function env vars (set in Supabase Dashboard → Edge Functions → Secrets)
# RESEND_API_KEY=re_...           # Required for email sending
# RESEND_FROM_EMAIL=مرسال الهدهد <noreply@yourdomain.com>  # Optional, defaults to onboarding@resend.dev
# CORS_ORIGIN=https://yourdomain.com  # Optional, for production domain
