# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Edge Function env vars (set in Supabase Dashboard → Edge Functions → Secrets)
# RESEND_API_KEY=re_...           # Required for email sending
# RESEND_FROM_EMAIL=مرسال الهدهد <noreply@yourdomain.com>  # Optional, defaults to onboarding@resend.dev
# CORS_ORIGIN=https://yourdomain.com  # Optional, for production domain
