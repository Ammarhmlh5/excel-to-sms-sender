## Supabase Functions environment variables example
# Copy this file to .env and fill values before running or deploying functions.

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Hudhud (hloov) API key used by send-sms/retry-sms
HUDHUD_API_KEY=your_hudhud_api_key_here
HUDHUD_SENDER_ID=your_sender_id_here
HUDHUD_BASE_URL=https://www.hloov.com/api/sms/send

# Resend (email) API key used by send-email
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="مرسال الهدهد <onboarding@example.com>"

# Optional: Expo Push (if you use Expo push endpoint)
EXPO_PUSH_TOKEN=

# Optional: other provider credentials (FCM, APNs)
FCM_SERVER_KEY=
APNS_KEY=
